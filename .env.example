# Spotify Developer App Client-ID (siehe README für Registrierung)
VITE_SPOTIFY_CLIENT_ID=

# Redirect-URI muss exakt im Spotify Developer Dashboard eingetragen sein.
# Für lokale Entwicklung z.B. http://127.0.0.1:5173/
# Für Produktion die URL deines statischen Hostings (z.B. GitHub Pages/Netlify).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
